<%- include('../partials/header') %>

<article class="course-card">
    <h1><%= course.title %></h1>

    <dl class="course-info">
        <dt>Количество кредитов</dt>
        <dd><%= course.credits %></dd>

        <dt>Семестр</dt>
        <dd><%= course.semester %></dd>

        <dt>Описание</dt>
        <dd><%= course.description %></dd>

        <dt>Преподаватель</dt>
        <dd>
            <% if (course.Teacher) { %>
                <a href="/teachers/<%= course.Teacher.id %>"><%= course.Teacher.name %></a>
            <% } else { %>
                —
            <% } %>
        </dd>

        <dt>Email преподавателя</dt>
        <dd><%= course.Teacher ? course.Teacher.email : '—' %></dd>

        <dt>Кафедра</dt>
        <dd><%= course.Teacher ? course.Teacher.department : '—' %></dd>
    </dl>

    <div class="actions">
        <a class="btn btn-secondary" href="/courses">&larr; К списку курсов</a>
        <a class="btn btn-edit" href="/courses/<%= course.id %>/edit">Редактировать</a>
        <form class="inline-form"
              action="/courses/<%= course.id %>/delete" method="POST"
              onsubmit="return confirm('Вы действительно хотите удалить этот курс?')">
            <button type="submit" class="btn btn-delete">Удалить</button>
        </form>
    </div>
</article>

<%- include('../partials/footer') %>