<%- include('../partials/header') %>

<h1>Список курсов</h1>

<div class="toolbar">
    <a class="btn btn-primary" href="/courses/new">+ Добавить курс</a>

    <form class="filter-form" action="/courses" method="GET">
        <input type="text" name="search" placeholder="Поиск по названию или преподавателю"
               value="<%= search %>">

        <select name="semester">
            <option value="">Все семестры</option>
            <% for (let i = 1; i <= 8; i++) { %>
                <option value="<%= i %>" <%= String(i) === semester ? 'selected' : '' %>>
                    Семестр <%= i %>
                </option>
            <% } %>
        </select>

        <button type="submit" class="btn btn-primary">Найти</button>
        <a class="btn btn-secondary" href="/courses">Сбросить</a>
    </form>
</div>

<% if (courses.length === 0) { %>
    <p class="empty">Курсы не найдены</p>
<% } else { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Преподаватель</th>
                    <th>Кредиты</th>
                    <th>Семестр</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                <% courses.forEach((course) => { %>
                    <tr>
                        <td><%= course.title %></td>
                        <td><%= course.teacher %></td>
                        <td><%= course.credits %></td>
                        <td><%= course.semester %></td>
                        <td class="actions">
                            <a class="btn btn-view" href="/courses/<%= course.id %>">Просмотр</a>
                            <a class="btn btn-edit" href="/courses/<%= course.id %>/edit">Редактировать</a>
                            <form class="inline-form"
                                  action="/courses/<%= course.id %>/delete" method="POST"
                                  onsubmit="return confirm('Удалить этот курс?')">
                                <button type="submit" class="btn btn-delete">Удалить</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>